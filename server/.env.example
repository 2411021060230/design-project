# ============================================================
# COPY this file to server/.env and replace the values there.
# The real .env file is ignored by Git. Never commit it.
# ============================================================

# Port the API listens on
PORT=5000
NODE_ENV=development

# MongoDB connection string
#   Local server:  mongodb://127.0.0.1:27017/gamified_learning
#   MongoDB Atlas: mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/gamified_learning
MONGODB_URI=mongodb://127.0.0.1:27017/gamified_learning

# Secret text used to sign login tokens. Use at least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Frontend address(es) allowed to call the API, separated by commas
CORS_ORIGIN=http://localhost:5173

# Cookie SameSite setting: "lax" for local development and same-site hosting.
# Use "none" only when the frontend and API are on different domains (requires HTTPS).
COOKIE_SAME_SITE=lax

# Code a teacher must type during sign-up. Leave it empty to turn off teacher sign-up.
TEACHER_INVITE_CODE=change-this-teacher-invite-code
